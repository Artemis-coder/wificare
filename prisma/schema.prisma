// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// Notifications in-app
// ----------------------------------------
// Rappel affiché dans l'application : le backend les écrit, le mobile les
// affiche. Pas de push : la consultation se fait par polling depuis l'écran
// dédié.
model Notification {
  id        String           @id @default(uuid())
  /// Destinataire : un client, un technicien ou un administrateur.
  userId    String
  type      NotificationType
  title     String
  body      String
  /// Demande concernée, pour amener l'utilisateur vers le détail.
  ticketId  String?
  /// Date de lecture. null = non lu.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Jeton de push d'un appareil.
///
/// Un utilisateur peut être connecté sur plusieurs téléphones : chaque
/// appareil enregistre son propre jeton. Le jeton est la clé d'adressage
/// fournie par Firebase Cloud Messaging, il est donc propre à l'appareil et
/// change si l'application est réinstallée.
model PushToken {
  id         String   @id @default(uuid())
  /// Adresse de l'appareil qui doit recevoir la notification.
  token      String   @unique
  userId     String
  /// Plateforme, pour pouvoir cibler un envoi ultérieur.
  platform   String   @default("android")
  /// Dernière confirmation de vie du jeton. Un jeton qui n'a pas été
  /// rafraîchi depuis plusieurs mois est considéré comme périmé.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Abonnement push d'un navigateur.
///
/// Le back-office prévient la régie même onglet fermé : c'est le seul moment où
/// une demande qui attend une répartition est visible, personne ne laisse un
/// tableau de bord ouvert en permanence pour guetter une ligne qui changerait.
///
/// L'abonnement est fourni par le navigateur et expire : le service de push le
/// répond `404` ou `410` quand il n'est plus valide, et il est alors retiré —
/// sinon chaque notification échouerait pour tout le monde à cause d'un poste
/// éteint depuis des mois.
model WebPushSubscription {
  id     String @id @default(uuid())
  /// Adresse du service de push du navigateur. Unique : un même navigateur ne
  /// s'abonne qu'une fois, et se réabonne après avoir révoqué son autorisation.
  endpoint String @unique
  userId   String
  /// Clé de chiffrement publique du navigateur (`p256dh`).
  p256dh   String
  /// Clé d'authentification du navigateur.
  auth     String
  /// Nom du navigateur et du système, pour que la régie sache quel poste est
  /// abonné : un abonnement orphelin est difficile à reconnaître.
  label    String?
  /// Dernière confirmation de vie : un abonnement inactif depuis plusieurs mois
  /// est considéré comme périmé.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  /// Une demande vient d'être soumise par un client.
  TICKET_SUBMITTED
  /// La demande a été affectée à un technicien.
  TICKET_ASSIGNED
  /// Le statut de la demande a changé.
  TICKET_STATUS_CHANGED
  /// La demande a été annulée.
  TICKET_CANCELED
  /// Le technicien a envoyé un devis au client.
  QUOTE_SENT
  /// Le client a accepté le devis.
  QUOTE_ACCEPTED
  /// Le client a refusé le devis.
  QUOTE_REJECTED
  /// Le client a réglé le devis.
  PAYMENT_RECEIVED
  /// Un client a déposé un avis sur l'intervention du technicien.
  EVALUATION_RECEIVED
  /// Un propriétaire a déclaré une nouvelle Wi-Fi Zone.
  ZONE_SUBMITTED
  /// Le super administrateur a validé, ou retiré du parc, une Wi-Fi Zone.
  ZONE_VALIDATED
  /// Une Wi-Fi Zone a été supprimée de la plateforme.
  ZONE_DELETED
  /// Message adressé par l'équipe d'administration à toute la plateforme.
  BROADCAST
}

// ----------------------------------------
// Campagnes de messages de la régie
// ----------------------------------------

/// État d'une campagne de message.
///
/// `SENDING` existe pour qu'une campagne ne puisse pas partir deux fois : la
/// reclaim est faite par une écriture conditionnelle, et le passage par cet
/// état rend la seconde tentative sans effet plutôt que doublant.
enum BroadcastStatus {
  /// Programmée, en attente de son heure.
  SCHEDULED
  /// Réclamée par un déclencheur, en cours d'envoi.
  SENDING
  /// Partie : les notifications et les push ont été déclenchés.
  SENT
  /// Annulée avant l'heure par la régie.
  CANCELLED
  /// L'envoi a échoué. `failureReason` dit pourquoi.
  FAILED
}

/// Un message de la régie à une audience.
///
/// L'historique ne pouvait pas être reconstruit à partir des notifications : une
/// campagne programmée n'a encore produit aucune notification, et il faut savoir
/// qu'elle est attendue avant de l'envoyer. Cette table est donc la source de
/// vérité, et les lignes `Notification` n'en sont que la trace chez les
/// destinataires.
model Broadcast {
  id String @id @default(uuid())
  title String
  body String
  /// Audience visée, telle que déclarée dans `BROADCAST_AUDIENCES`.
  audience String
  /// Heure d'envoi voulue, en UTC. Une campagne programmée est stockée dans le
  /// même champ qu'un envoi immédiat : l'heure est celle de l'envoi.
  scheduledFor DateTime
  status BroadcastStatus @default(SCHEDULED)
  /// Date d'envoi effectif, une fois la campagne partie.
  sentAt DateTime?
  /// Destinataires au moment de l'envoi : une audience est résolue à cet
  /// instant-là, pas à la programmation, et l'équipe peut changer d'ici là.
  recipients Int @default(0)
  /// Dont joignables hors application, c'est-à-dire possédant un téléphone
  /// abonné. Mesuré à l'envoi, pour que le chiffre affiché soit exact.
  /// `null` quand la campagne est antérieure à la console : le nombre n'a pas
  /// été relevé, et un chiffre deviné dans un indicateur est pire qu'un trou.
  devices Int?
  /// Pourquoi l'envoi a échoué, si c'est le cas.
  failureReason String?
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("Broadcasts", fields: [createdById], references: [id], onDelete: Cascade)

  /// Balayage des campagnes dues : la requête de la reclaim filtre sur ces
  /// deux colonnes, dans cet ordre.
  @@index([status, scheduledFor])
  @@index([createdAt])
}

// ----------------------------------------
// Utilisateurs & Authentification
// ----------------------------------------
model User {
  id           String     @id @default(uuid())
  name         String?
  firstName    String?
  lastName     String?
  phone        String     @unique
  /// Empreinte du mot de passe de 4 chiffres (scrypt + sel), null tant que le
  /// compte n'a été créé que par OTP.
  passwordHash String?
  role         Role       @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  clients         Client[]       @relation("ClientUsers")
  tickets         Ticket[]       @relation("TechnicianTickets")
  evaluations     Evaluation[]
  /// Avis reçus sur leurs interventions.
  reviewsReceived Evaluation[]   @relation("EvaluatedTechnician")
  notifications   Notification[]
  /// Jetons de push des appareils de ce compte.
  pushTokens      PushToken[]
  /// Navigateurs du back-office abonnés aux notifications hors application.
  pushSubscriptions WebPushSubscription[]
  /// Campagnes de messages composées par ce compte.
  broadcasts Broadcast[] @relation("Broadcasts")
  /// Suivis de position que ce technicien a envoyés sur ses demandes.
  technicianTrackings TechnicianTracking[]
}

enum Role {
  /// Super administrateur : seul rôle d'administration. Gère l'ensemble de la
  /// plateforme : les comptes et leurs rôles, les Wi-Fi Zones de tous les
  /// propriétaires, la validation des zones déclarées et la répartition des
  /// interventions.
  SUPER_ADMIN
  TECHNICIAN
  /// Propriétaire d'une ou plusieurs Wi-Fi Zones.
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ----------------------------------------
// Clients & Wi-Fi Zones
// ----------------------------------------
model Client {
  id        String   @id @default(uuid())
  name      String
  contact   String
  address   String?
  latitude  Float?
  longitude Float?
  userId    String?
  createdAt DateTime @default(now())

  user      User?      @relation("ClientUsers", fields: [userId], references: [id])
  wifiZones WifiZone[]
  tickets   Ticket[]
}

model WifiZone {
  id        String     @id @default(uuid())
  clientId  String
  name      String
  location  String
  /// Statut de validation. Une zone déclarée par son propriétaire attend la
  /// validation du super administrateur avant d'entrer dans le parc exploité :
  /// une zone non validée n'apparaît pas dans les listes de Tickets et ne peut
  /// pas recevoir de demande d'intervention.
  status    ZoneStatus @default(PENDING)
  /// Latitude de la destination, relevée par le client. Null tant que le client
  /// n'a pas partagé sa position : l'ETA ne peut être calculée sans elle.
  latitude  Float?
  /// Longitude de la destination, relevée par le client. Doit être renseignée
  /// en même temps que `latitude` pour former une destination valide.
  longitude Float?
  createdAt DateTime   @default(now())

  client     Client               @relation(fields: [clientId], references: [id])
  equipments Equipment[]
  tickets    Ticket[]
}

/// Cycle de vie d'une Wi-Fi Zone.
enum ZoneStatus {
  /// Déclarée par son propriétaire, en attente de validation.
  PENDING
  /// Validée par le super administrateur, exploitable.
  ACTIVE
}

model Equipment {
  id           String   @id @default(uuid())
  wifiZoneId   String
  type         String // e.g., Routeur, Switch, ONT
  brand        String?
  model        String?
  serialNumber String?
  createdAt    DateTime @default(now())

  wifiZone WifiZone @relation(fields: [wifiZoneId], references: [id])
}

// ----------------------------------------
// Tickets & Interventions
// ----------------------------------------
model Ticket {
  id           String       @id @default(uuid())
  reference    String       @unique // e.g., #TK-2026-001
  type         String // Panne, Lenteur, Installation
  priority     Priority     @default(NORMAL)
  status       TicketStatus @default(NEW)
  scheduledFor DateTime?
  description  String?
  clientId     String
  wifiZoneId   String
  technicianId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  wifiZone      WifiZone       @relation(fields: [wifiZoneId], references: [id])
  technician    User?          @relation("TechnicianTickets", fields: [technicianId], references: [id])
  files         File[]
  intervention  Intervention?
  quoteInvoice  QuoteInvoice?
  evaluation    Evaluation?
  notifications Notification[]
  tracking      TechnicianTracking[]
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  NEW // Nouveau
  TO_VERIFY // À vérifier
  ASSIGNED // Affecté
  CONFIRMED // Rendez-vous confirmé
  EN_ROUTE // En route
  DIAGNOSING // En diagnostic
  PENDING_QUOTE // Devis en attente
  REPAIRING // En réparation
  COMPLETED // Terminé
  PENDING_PAYMENT // Paiement en attente
  CLOSED // Clôturé
  CANCELED // Annulé
}

// ----------------------------------------
// Fichiers (Preuves)
// ----------------------------------------
model File {
  id        String   @id @default(uuid())
  ticketId  String
  url       String
  fileType  FileType // Photo, Video, Audio
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ----------------------------------------
// Interventions & Rapports
// ----------------------------------------
model Intervention {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  checklist   Json? // e.g. { "router_restarted": true, "cable_checked": false }
  diagnostic  String?
  solution    String?
  durationMin Int?
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// ----------------------------------------
// Devis, Factures & Paiements
// ----------------------------------------
model QuoteInvoice {
  id          String         @id @default(uuid())
  ticketId    String         @unique
  type        DocumentType
  status      DocumentStatus @default(DRAFT)
  totalAmount Float          @default(0)
  /// Observations libres du technicien, ajoutées après les lignes du devis.
  /// Elles ne sont pas facturées : elles expliquent l'intervention.
  notes       String?

  /// Date d'envoi au client. Distincte de `createdAt`, qui date la rédaction.
  sentAt DateTime?
  /// Date de la décision du client sur le devis.
  ///
  /// Elle est conservée même après règlement : « envoyé le », « accepté le »
  /// et « payé le » sont trois faits distincts, et seul le dernier clôt le
  /// dossier. La garder évite de lire l'acceptation dans l'horodatage d'un
  /// paiement effectué des semaines plus tard.
  acceptedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ticket  Ticket        @relation(fields: [ticketId], references: [id])
  lines   InvoiceLine[]
  payment Payment?
}

enum DocumentType {
  QUOTE
  INVOICE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
}

model InvoiceLine {
  id             String @id @default(uuid())
  quoteInvoiceId String
  description    String
  quantity       Int    @default(1)
  unitPrice      Float
  totalPrice     Float

  quoteInvoice QuoteInvoice @relation(fields: [quoteInvoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String               @id @default(uuid())
  quoteInvoiceId String               @unique
  amount         Float
  channel        PaymentChannel
  /// Opérateur du paiement mobile (Wave, Orange, MTN). Null pour un règlement
  /// en espèces ou par virement : ces moyens n'ont pas d'opérateur.
  operator       MobileMoneyOperator?
  /// Référence de la transaction Mobile Money, saisie par le client.
  transactionRef String?
  /// Référence classique, conservée pour les virements.
  reference      String?
  proofUrl       String?
  status         PaymentStatus        @default(PENDING)
  createdAt      DateTime             @default(now())

  quoteInvoice QuoteInvoice @relation(fields: [quoteInvoiceId], references: [id])
}

enum PaymentChannel {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum MobileMoneyOperator {
  WAVE
  ORANGE
  MTN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ----------------------------------------
// Évaluations
// ----------------------------------------

/// Suivi de position d'un technicien sur une demande.
///
/// Une ligne par ticket (`ticketId` unique) : le technicien envoie sa position
/// régulièrement, et le client la lit pour afficher une ETA. La ligne existe
/// dès le premier point, et `stoppedAt` est mis à jour quand le technicien
/// arrête le suivi ; actif = ligne présente et `stoppedAt` nul.
model TechnicianTracking {
  id               String   @id @default(uuid())
  ticketId         String   @unique
  technicianId     String
  latitude         Float
  longitude        Float
  accuracy         Float?
  speed            Float?
  heading          Float?
  /// Distance à vol d'oiseau entre le technicien et la destination, en mètres.
  /// Null si la destination (coordonnées de zone) est inconnue.
  distanceMeters   Int?
  /// Estimation de l'arrivée en minutes, null si la destination est inconnue.
  etaMinutes      Int?
  startedAt        DateTime @default(now())
  /// Horodatage de la position telle qu'elle a été reçue par le serveur.
  /// Sert à la fois de `recordedAt` renvoyé au client et au bridage des push.
  recordedAt       DateTime
  stoppedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician   User   @relation(fields: [technicianId], references: [id])

  @@index([ticketId, recordedAt])
  @@index([technicianId])
}

/// Avis d'un client sur une intervention.
///
/// Rattachée à la demande, donc à l'intervention concernée, et au technicien qui
/// l'a réalisée : sans ce second lien, la régie ne peut pas répondre à « quel
/// technicien est mal noté » sans parcourir toutes les interventions.
model Evaluation {
  id       String @id @default(uuid())
  ticketId String @unique
  clientId String

  /// Technicien ayant réalisé l'intervention, figé à la rédaction de l'avis.
  technicianId String?

  rating    Int // 1 à 5
  comment   String?
  createdAt DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  client     User   @relation(fields: [clientId], references: [id])
  technician User?  @relation("EvaluatedTechnician", fields: [technicianId], references: [id])

  @@index([technicianId])
  @@index([clientId])
}
