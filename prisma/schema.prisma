// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------
// Notifications in-app
// ----------------------------------------
// Rappel affiché dans l'application : le backend les écrit, le mobile les
// affiche. Pas de push : la consultation se fait par polling depuis l'écran
// dédié.
model Notification {
  id        String           @id @default(uuid())
  /// Destinataire : un client, un technicien ou un administrateur.
  userId    String
  type      NotificationType
  title     String
  body      String
  /// Demande concernée, pour amener l'utilisateur vers le détail.
  ticketId  String?
  /// Date de lecture. null = non lu.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Jeton de push d'un appareil.
///
/// Un utilisateur peut être connecté sur plusieurs téléphones : chaque
/// appareil enregistre son propre jeton. Le jeton est la clé d'adressage
/// fournie par Firebase Cloud Messaging, il est donc propre à l'appareil et
/// change si l'application est réinstallée.
model PushToken {
  id         String   @id @default(uuid())
  /// Adresse de l'appareil qui doit recevoir la notification.
  token      String   @unique
  userId     String
  /// Plateforme, pour pouvoir cibler un envoi ultérieur.
  platform   String   @default("android")
  /// Dernière confirmation de vie du jeton. Un jeton qui n'a pas été
  /// rafraîchi depuis plusieurs mois est considéré comme périmé.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Abonnement push d'un navigateur.
///
/// Le back-office prévient la régie même onglet fermé : c'est le seul moment où
/// une demande qui attend une répartition est visible, personne ne laisse un
/// tableau de bord ouvert en permanence pour guetter une ligne qui changerait.
///
/// L'abonnement est fourni par le navigateur et expire : le service de push le
/// répond `404` ou `410` quand il n'est plus valide, et il est alors retiré —
/// sinon chaque notification échouerait pour tout le monde à cause d'un poste
/// éteint depuis des mois.
model WebPushSubscription {
  id     String @id @default(uuid())
  /// Adresse du service de push du navigateur. Unique : un même navigateur ne
  /// s'abonne qu'une fois, et se réabonne après avoir révoqué son autorisation.
  endpoint String @unique
  userId   String
  /// Clé de chiffrement publique du navigateur (`p256dh`).
  p256dh   String
  /// Clé d'authentification du navigateur.
  auth     String
  /// Nom du navigateur et du système, pour que la régie sache quel poste est
  /// abonné : un abonnement orphelin est difficile à reconnaître.
  label    String?
  /// Dernière confirmation de vie : un abonnement inactif depuis plusieurs mois
  /// est considéré comme périmé.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  /// Une demande vient d'être soumise par un client.
  TICKET_SUBMITTED
  /// La demande a été affectée à un technicien.
  TICKET_ASSIGNED
  /// Le statut de la demande a changé.
  TICKET_STATUS_CHANGED
  /// La demande a été annulée.
  TICKET_CANCELED
  /// Le technicien a envoyé un devis au client.
  QUOTE_SENT
  /// Le client a réglé le devis.
  PAYMENT_RECEIVED
  /// Un client a déposé un avis sur l'intervention du technicien.
  EVALUATION_RECEIVED
  /// Message adressé par l'équipe d'administration à toute la plateforme.
  BROADCAST
}

// ----------------------------------------
// Utilisateurs & Authentification
// ----------------------------------------
model User {
  id           String     @id @default(uuid())
  name         String?
  firstName    String?
  lastName     String?
  phone        String     @unique
  /// Empreinte du mot de passe de 4 chiffres (scrypt + sel), null tant que le
  /// compte n'a été créé que par OTP.
  passwordHash String?
  role         Role       @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  clients         Client[]       @relation("ClientUsers")
  tickets         Ticket[]       @relation("TechnicianTickets")
  evaluations     Evaluation[]
  /// Avis reçus sur leurs interventions.
  reviewsReceived Evaluation[]   @relation("EvaluatedTechnician")
  notifications   Notification[]
  /// Jetons de push des appareils de ce compte.
  pushTokens      PushToken[]
  /// Navigateurs du back-office abonnés aux notifications hors application.
  pushSubscriptions WebPushSubscription[]
}

enum Role {
  /// Super administrateur : seul rôle autorisé à gérer les comptes, les rôles
  /// et les zones à l'échelle de la plateforme.
  SUPER_ADMIN
  ADMIN
  TECHNICIAN
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ----------------------------------------
// Clients & Wi-Fi Zones
// ----------------------------------------
model Client {
  id        String   @id @default(uuid())
  name      String
  contact   String
  address   String?
  latitude  Float?
  longitude Float?
  userId    String?
  createdAt DateTime @default(now())

  user      User?      @relation("ClientUsers", fields: [userId], references: [id])
  wifiZones WifiZone[]
  tickets   Ticket[]
}

model WifiZone {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  location  String
  createdAt DateTime @default(now())

  client     Client      @relation(fields: [clientId], references: [id])
  equipments Equipment[]
  tickets    Ticket[]
}

model Equipment {
  id           String   @id @default(uuid())
  wifiZoneId   String
  type         String // e.g., Routeur, Switch, ONT
  brand        String?
  model        String?
  serialNumber String?
  createdAt    DateTime @default(now())

  wifiZone WifiZone @relation(fields: [wifiZoneId], references: [id])
}

// ----------------------------------------
// Tickets & Interventions
// ----------------------------------------
model Ticket {
  id           String       @id @default(uuid())
  reference    String       @unique // e.g., #TK-2026-001
  type         String // Panne, Lenteur, Installation
  priority     Priority     @default(NORMAL)
  status       TicketStatus @default(NEW)
  scheduledFor DateTime?
  description  String?
  clientId     String
  wifiZoneId   String
  technicianId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  wifiZone      WifiZone       @relation(fields: [wifiZoneId], references: [id])
  technician    User?          @relation("TechnicianTickets", fields: [technicianId], references: [id])
  files         File[]
  intervention  Intervention?
  quoteInvoice  QuoteInvoice?
  evaluation    Evaluation?
  notifications Notification[]
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  NEW // Nouveau
  TO_VERIFY // À vérifier
  ASSIGNED // Affecté
  CONFIRMED // Rendez-vous confirmé
  EN_ROUTE // En route
  DIAGNOSING // En diagnostic
  PENDING_QUOTE // Devis en attente
  REPAIRING // En réparation
  COMPLETED // Terminé
  PENDING_PAYMENT // Paiement en attente
  CLOSED // Clôturé
  CANCELED // Annulé
}

// ----------------------------------------
// Fichiers (Preuves)
// ----------------------------------------
model File {
  id        String   @id @default(uuid())
  ticketId  String
  url       String
  fileType  FileType // Photo, Video, Audio
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ----------------------------------------
// Interventions & Rapports
// ----------------------------------------
model Intervention {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  checklist   Json? // e.g. { "router_restarted": true, "cable_checked": false }
  diagnostic  String?
  solution    String?
  durationMin Int?
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
}

// ----------------------------------------
// Devis, Factures & Paiements
// ----------------------------------------
model QuoteInvoice {
  id          String         @id @default(uuid())
  ticketId    String         @unique
  type        DocumentType
  status      DocumentStatus @default(DRAFT)
  totalAmount Float          @default(0)
  /// Observations libres du technicien, ajoutées après les lignes du devis.
  /// Elles ne sont pas facturées : elles expliquent l'intervention.
  notes       String?

  /// Date d'envoi au client. Distincte de `createdAt`, qui date la rédaction.
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ticket  Ticket        @relation(fields: [ticketId], references: [id])
  lines   InvoiceLine[]
  payment Payment?
}

enum DocumentType {
  QUOTE
  INVOICE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  PAID
}

model InvoiceLine {
  id             String @id @default(uuid())
  quoteInvoiceId String
  description    String
  quantity       Int    @default(1)
  unitPrice      Float
  totalPrice     Float

  quoteInvoice QuoteInvoice @relation(fields: [quoteInvoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String               @id @default(uuid())
  quoteInvoiceId String               @unique
  amount         Float
  channel        PaymentChannel
  /// Opérateur du paiement mobile (Wave, Orange, MTN). Null pour un règlement
  /// en espèces ou par virement : ces moyens n'ont pas d'opérateur.
  operator       MobileMoneyOperator?
  /// Référence de la transaction Mobile Money, saisie par le client.
  transactionRef String?
  /// Référence classique, conservée pour les virements.
  reference      String?
  proofUrl       String?
  status         PaymentStatus        @default(PENDING)
  createdAt      DateTime             @default(now())

  quoteInvoice QuoteInvoice @relation(fields: [quoteInvoiceId], references: [id])
}

enum PaymentChannel {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum MobileMoneyOperator {
  WAVE
  ORANGE
  MTN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ----------------------------------------
// Évaluations
// ----------------------------------------
/// Avis d'un client sur une intervention.
///
/// Rattachée à la demande, donc à l'intervention concernée, et au technicien qui
/// l'a réalisée : sans ce second lien, la régie ne peut pas répondre à « quel
/// technicien est mal noté » sans parcourir toutes les interventions.
model Evaluation {
  id       String @id @default(uuid())
  ticketId String @unique
  clientId String

  /// Technicien ayant réalisé l'intervention, figé à la rédaction de l'avis.
  technicianId String?

  rating    Int // 1 à 5
  comment   String?
  createdAt DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id])
  client     User   @relation(fields: [clientId], references: [id])
  technician User?  @relation("EvaluatedTechnician", fields: [technicianId], references: [id])

  @@index([technicianId])
  @@index([clientId])
}
