  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jsonwebtoken": "^9.0.10",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.7",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  }
}
