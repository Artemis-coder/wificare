# Connexion a la base PostgreSQL.
# Neon : recuperer l'URL dans le tableau de bord du projet.
# Local : postgresql://user:motdepasse@localhost:5432/wificare
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# Secret de signature des jetons de session (JWT).
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplacer-par-un-secret-aleatoire"

# URL publique de l'application, utilisee par NextAuth.
NEXTAUTH_URL="http://localhost:3000"

# Notifications push vers les navigateurs de la regie.
#
# Le back-office previent la regie meme onglet ferme. Le transport retenu est
# Web Push (VAPID), et non Firebase : ce dernier exige d'enregistrer une
# application Web dans la console Firebase et d'y generer un certificat de
# notification, autant d'etapes que l'on voulait eviter.
#
# La paire se genere localement, sans compte ni console externe :
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# NEXT_PUBLIC_* est expose au navigateur : n'y mettez que la cle publique.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="cle-publique-generee"
VAPID_PRIVATE_KEY="cle-privee-generee"
# Contact exige par la specification Web Push, signale par le navigateur quand un
# envoi est refuse : une adresse joignable de la regie.
VAPID_SUBJECT="mailto:support@wificare.ci"
