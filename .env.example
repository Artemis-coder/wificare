# Connexion a la base PostgreSQL.
# Neon : recuperer l'URL dans le tableau de bord du projet.
# Local : postgresql://user:motdepasse@localhost:5432/wificare
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# Secret de signature des jetons de session (JWT).
# Generer avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplacer-par-un-secret-aleatoire"

# URL publique de l'application, utilisee par NextAuth.
NEXTAUTH_URL="http://localhost:3000"

# Notifications push vers les navigateurs de la regie.
#
# Le back-office previent la regie meme onglet ferme. Le transport retenu est
# Web Push (VAPID), et non Firebase : ce dernier exige d'enregistrer une
# application Web dans la console Firebase et d'y generer un certificat de
# notification, autant d'etapes que l'on voulait eviter.
#
# La paire se genere localement, sans compte ni console externe :
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
#
# NEXT_PUBLIC_* est expose au navigateur : n'y mettez que la cle publique.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="cle-publique-generee"
VAPID_PRIVATE_KEY="cle-privee-generee"
# Contact exige par la specification Web Push, signale par le navigateur quand un
# envoi est refuse : une adresse joignable de la regie.
VAPID_SUBJECT="mailto:support@wificare.ci"

# Notifications push vers les telephones Android (Firebase Cloud Messaging).
#
# Distinct de VAPID ci-dessus, qui ne concerne que les navigateurs du back-office.
# Sans cette variable, un message envoye depuis /admin/notifications est bien
# enregistre et visible dans l'application, mais aucun telephone ne sonne : rien
# ne signale l'echec, et la campagne a l'air d'avoir fonctionne.
#
# Firebase est la seule voie qui traverse Android sans maintenir de connexion
# (l'OS repete lui-meme l'envoi). Pour l'obtenir : console Firebase >
# Parametres du projet > Comptes de service > Generer une nouvelle cle privee, le
# fichier JSON tel quel, colle ici en une seule valeur.
#
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}'
#
# Accepte aussi le JSON encode en base64. cote application, le meme projet
# Firebase doit fournir mobile/android/app/google-services.json.
FIREBASE_SERVICE_ACCOUNT=""

# Declenchement des campagnes de messages programmees.
#
# GET /api/cron/broadcasts envoie les campagnes dont l'heure est venue et
# marque celles qui ont echoue. Sans ce secret, la route refuse de fonctionner et
# l'envoi programme est desactive : une campagne programmee resterait indefiniment
# en attente, ce que le declencheur signale plutot que de faire croire que tout
# est parti. A appeler depuis le planificateur de Vercel, ou depuis n'importe quel
# cron qui peut poser un en-tete.
#   x-cron-secret: <valeur ci-dessous>
BROADCAST_CRON_SECRET=""

# PostHog — observabilite du back-office.
#
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN est le jeton de projet ("Project API key" dans
# PostHog > Project settings, prefixe phc_). Il part dans le bundle navigateur :
# c'est une cle publique, presentee a tous les visiteurs, et c'est normal. Elle
# ne permet que d'ecrire des evenements dans CE projet.
#
# NEXT_PUBLIC_POSTHOG_HOST est le point d'ingestion, pas l'adresse de l'interface.
# US : https://us.i.posthog.com — EU : https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_remplacer-par-le-jeton-de-projet"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Suivi des erreurs : envoi des source maps au moment du build.
#
# Sans ces deux variables, `npm run build` fonctionne mais n'envoie aucune carte
# source : les exceptions remontees dans PostHog portent alors des piles
# minifiees illisibles, et on ne peut pas deviner quel ecrit a echoue.
#
# POSTHOG_API_KEY est, elle, une cle privee (prefixe phx_, PostHog > Settings >
# Personal API keys). Elle n'est donc jamais NEXT_PUBLIC_ : elle sert au build
# pour authentifier l'envoi des cartes source, et rien d'autre.
#
# Le build s'execute sur Vercel : ces deux variables doivent y etre declarees
# aussi, sinon seul le build local enverra des cartes source.
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
