<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 13 (API 33) exige une autorisation explicite pour afficher une
         notification : sans elle, une demande reçue reste invisible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Suivi de position du technicien pendant son déplacement ("votre
         technicien arrive dans ~7 min"). Seule la localisation fine est
         demandée : c'est la précision qui permet au serveur de calculer une
         distance et une ETA crédibles. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- Repli si l'utilisateur refuse la localisation fine : Android affiche
         alors une demande de permission dégradée, mais le GPS d'un téléphone
         reste la source la plus fiable en déplacement. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 10 (API 29) exige une autorisation distincte pour suivre la
         position quand l'application n'est plus au premier plan. C'est le cas
         d'usage visé — téléphone en poche — et Android 14 refuse purement et
         simplement d'ouvrir un service de premier plan de type localisation
         sans elle. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Autorise l'exécution en premier plan : c'est la seule façon de
         continuer à recevoir des points quand Android suspend l'application. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- Android 14 (API 34) exige que le type du service soit déclaré ET
         autorisé : sans ce couple, `startForeground` lève une exception. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <application
        android:label="WiFiCare"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Le service de partage de position est instancié par Android, jamais
             par le code Dart : le type `location` doit être déclaré, faute de
             quoi Android 14 refuse d'ouvrir le service de premier plan. -->
        <service
            android:name=".LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Le canal doit exister *avant* la première notification, y compris quand
             l'application est arrêtée : le SDK Android n'en crée pas un lui-même,
             et le canal qu'il invente est en importance basse, donc muet. L'application
             crée ce canal à la connexion (push_service.dart) ; ces deux entrées
             disent au SDK lequel utiliser dans le cas général. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="wificare_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Ouverture d'une fiche zone, d'un appel téléphonique et des pièces jointes -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
